# 连接跟踪（conntrack）调优 —— 说明见 docs/PLUGINS.md 第 20 节
#
# 背景：抖音 / 红果这类字节系 App 全走 QUIC（UDP/443），每换一个视频分片、每换一个
# CDN 节点就是一条新的五元组；UDP 没有挥手包，路由器只能靠超时回收。内核默认
# udp_timeout_stream=180 秒，几台设备一起刷就能把 nf_conntrack 表顶满，表现是
# 「看一会儿全网卡一下、过一会儿自己好」。
#
# 这里只改运行参数，不换包、不改内核；改完 /etc/init.d/conntrack-tune restart 即可。

config conntrack 'settings'
	# 总开关。0 = 完全不动系统默认值
	option enabled '1'
	# 表项上限。auto = 按内存自动分档（2G→262144 / 1G→131072 / 其它→65536）
	# 也可以直接写数字，例如 '131072'
	#
	# 注意：nf_conntrack_max 不会随内存自动放大，OpenWrt 上通常固定 16384 或 65536，
	# 插 2G 内存也一样 —— 这就是「内存够大但还是爆表」的原因。
	option max 'auto'
	# UDP 单向超时（秒）。只发不收的残留条目，内核默认 30
	option udp_timeout '20'
	# UDP 双向超时（秒）。QUIC 走这条，内核默认 180；60 秒对视频观感没有影响
	option udp_timeout_stream '60'
	# 已建立 TCP 的空闲回收（秒）。内核默认 7440，缩到 1 小时能腾出不少位置
	option tcp_timeout_established '3600'

config quic 'quic'
	# 默认关闭（2026-11-25 起）：全封 QUIC 太粗暴，YouTube / 部分游戏只认 QUIC，
	# 封了会逼它们降级重试、CPU 反而更忙。
	# 现在推荐用下面的「定时收割」（config reap），只清空闲流、不影响活跃连接。
	#
	# 真要对某几台设备彻底封 QUIC，把它打开并填 mac 列表：
	#   打开后，列表里的设备发往 UDP/443 的包在 prerouting/raw 就被丢掉，
	#   conntrack 表项一条都不会建（抖音/红果会自动回落 TCP/443）。
	#   mac 列表为空 = 封全部 LAN 客户端（只匹配 br-lan 进来的包）。
	option enabled '0'
	# 可选的 LAN 接口名（默认 br-lan）
	# option iface 'br-lan'
	# 设备 MAC，一行一台；留空 = 封全部
	# list mac 'aa:bb:cc:dd:ee:ff'

config reap 'reap'
	# 定时清理「活得太久」的 UDP 连接（每分钟一次，由 cron 触发）。
	# 只删空闲超时时间的条目，不碰正在传数据的流。
	option enabled '1'
	# 空闲多少秒就清掉。太小会误杀（比如游戏 30 秒才发一次保活包），
	# 建议 20~40。抖动明显就往上调。
	option age '25'
	# 只清这个目标端口的 UDP；0 = 所有 UDP
	option port '443'
	# 1 = 有清理动作时写 syslog（logger -t conntrack-reap）
	option log '0'
