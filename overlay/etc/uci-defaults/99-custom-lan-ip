#!/bin/sh
# 把 LAN 改成 192.168.10.254/24，DHCP 池跟着换网段。
#
# 关键规则（2026-11-21 明确）：
#   - 不保留数据升级（sysupgrade -n）→ 配置全新，脚本会设好 192.168.10.254
#   - 保留数据升级（sysupgrade 默认）→ **完全不动** LAN IP，用户改成什么就是什么
#
# 为什么原来做不到：sysupgrade 保留数据时只会带走 /etc/config 等白名单目录，
# overlay 里「uci-defaults 已执行」的删除标记会丢，脚本于是又跑一遍，把 IP 改回去。
# 现在用 /etc/config 下的标记文件（这个目录一定会被 sysupgrade 保留）来记住
# 「这台设备的 LAN 已经配过了」，跨升级都不会再动。

MARK=/etc/config/.lan_ip_initialized

# 已经初始化过 → 保留数据升级时什么都不做
[ -f "$MARK" ] && exit 0

# 配置还没生成（理论上前置脚本会先生成），交给系统自己处理
[ -f /etc/config/network ] || exit 0
[ -f /etc/config/dhcp ] || exit 0

# 已经是用户自定义过的网段（不是 OpenWrt 默认的 192.168.1.1，也不是我们的默认值）
# → 视为用户自己配过了，尊重现状，只补一个标记
cur=$(uci -q get network.lan.ipaddr)
case "$cur" in
	''|'192.168.1.1'|'192.168.10.254') ;;   # 默认值 / 我们的值 → 继续往下设置
	*)
		touch "$MARK"
		exit 0
		;;
esac

uci set network.lan.ipaddr='192.168.10.254'
uci set network.lan.netmask='255.255.255.0'
uci -q delete network.lan.gateway

# DHCP 池必须落在新网段里，否则客户端拿不到地址
uci set dhcp.lan.start='100'
uci set dhcp.lan.limit='150'
uci set dhcp.lan.leasetime='12h'

uci commit network
uci commit dhcp

touch "$MARK"

exit 0
