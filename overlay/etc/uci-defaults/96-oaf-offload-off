#!/bin/sh
# OAF（应用过滤）装上之后，把硬件/软件 flow offload 关掉。
#
# 原因：OAF 是 DPI，靠 netfilter 钩子逐包识别；而 offload 之后数据包直接走
# 硬件（NSS）或 nf_flowtable，钩子根本不会被调用 —— 表现是"识别不准、统计不对、
# 长连接拦不住"。
#
# 只在装了 OAF 的固件上生效（enable_oaf=yes 编出来的），普通固件不受影响。

[ -x /usr/sbin/oaf ] || [ -x /etc/init.d/oaf ] || exit 0

uci -q set firewall.@defaults[0].flow_offloading='0'
uci -q set firewall.@defaults[0].flow_offloading_hw='0'
uci -q commit firewall

logger -t oaf-tuning "检测到 OAF，已关闭 flow offloading（软件+硬件）"
exit 0
