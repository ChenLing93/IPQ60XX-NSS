# =====================================================================
#  变体：带无线（WiFi）
#  目标默认包本来就是 ath11k + wpad-openssl，这里显式再写一遍，
#  一是自文档化，二是防止上游改默认包后这两个版本悄悄变成一样。
# =====================================================================

# ---- 无线驱动（ath11k，IPQ6000 是 AHB 口）----
CONFIG_PACKAGE_kmod-ath11k=y
CONFIG_PACKAGE_kmod-ath11k-ahb=y
CONFIG_PACKAGE_kmod-ath11k-pci=y

# ---- 无线认证端（hostapd 的 OpenSSL 变体，LuCI 无线页面依赖它）----
CONFIG_PACKAGE_wpad-openssl=y

# ---- ath11k 与 NSS 的协同 ----
# Wi-Fi 卸载 / mesh 支持（满血 NSS 的无线部分靠这两个）
CONFIG_ATH11K_NSS_MESH_SUPPORT=y
# ath11k 内存档位（AX5 / M2 都是 1G 内存，512M 档留余量；wifi 异常可降档）
CONFIG_ATH11K_MEM_PROFILE_512M=y
