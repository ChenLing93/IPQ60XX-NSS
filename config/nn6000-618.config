# NN6000 v2 / 6.18 + NSS + PPE —— 单独一条实验线
#
# 来源：VIKINGYFY/immortalwrt 的 owrt 分支（内核 6.18，NSS 与 PPE 双卸载）
# 只编 link_nn6000-v2、只出 NOWIFI，其它机型一律不动。
#
# 和主线（LibWrt 25.12 / 6.12）完全独立：不同的源、不同的配置、不同的产物目录。

# 设备平台
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_MULTI_PROFILE=n

# 只选这一台
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_link_nn6000-v2=y

# NOWIFI：关掉无线（和主线 NOWIFI 版一致）
CONFIG_PACKAGE_kmod-ath=n
CONFIG_PACKAGE_kmod-ath11k=n
CONFIG_PACKAGE_kmod-ath11k-ahb=n
CONFIG_PACKAGE_kmod-ath11k-pci=n
CONFIG_PACKAGE_ath11k-firmware-ipq6018=n
CONFIG_PACKAGE_ath11k-firmware-ipq6018-ddwrt=n
CONFIG_PACKAGE_ath11k-firmware-qcn9074=n
CONFIG_PACKAGE_ath11k-firmware-qcn9074-ddwrt=n
CONFIG_PACKAGE_wpad-openssl=n
CONFIG_PACKAGE_wpad-basic-mbedtls=n
CONFIG_PACKAGE_hostapd-common=n
CONFIG_PACKAGE_kmod-mac80211=n

# 跑分（对应主线那套 coremark）
CONFIG_PACKAGE_coremark=y
CONFIG_COREMARK_OPTIMIZE_O3=y
CONFIG_COREMARK_ENABLE_MULTITHREADING=y
CONFIG_COREMARK_NUMBER_OF_THREADS=4

# 基础工具：看 NSS/PPE 状态、排查用
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_tcpdump-mini=y
CONFIG_PACKAGE_jq=y
CONFIG_PACKAGE_htop=y

# 界面
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
