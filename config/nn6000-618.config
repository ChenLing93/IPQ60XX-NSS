# NN6000 v2 / 6.18 + NSS + PPE —— 单独一条实验线
#
# 来源：VIKINGYFY/immortalwrt 的 owrt 分支（内核 6.18，NSS 与 PPE 双卸载）
# 只编 link_nn6000-v2、只出 NOWIFI，其它机型一律不动。
#
# 和主线（LibWrt 25.12 / 6.12）完全独立：不同的源、不同的配置、不同的产物目录。

# 设备平台
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y

# 只选这一台。
# 这棵树的 defconfig 默认是「单 profile」（会自己挑列表第一个机型），
# 必须显式打开 MULTI_PROFILE，CONFIG_TARGET_DEVICE_...=y 才会被认。
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_link_nn6000-v2=y

# NOWIFI：关掉无线（和主线 NOWIFI 版一致）
CONFIG_PACKAGE_kmod-ath=n
CONFIG_PACKAGE_kmod-ath11k=n
CONFIG_PACKAGE_kmod-ath11k-ahb=n
CONFIG_PACKAGE_kmod-ath11k-pci=n
CONFIG_PACKAGE_ath11k-firmware-ipq6018=n
CONFIG_PACKAGE_ath11k-firmware-ipq6018-ddwrt=n
CONFIG_PACKAGE_ath11k-firmware-qcn9074=n
CONFIG_PACKAGE_ath11k-firmware-qcn9074-ddwrt=n
CONFIG_PACKAGE_wpad-openssl=n
CONFIG_PACKAGE_wpad-basic-mbedtls=n
CONFIG_PACKAGE_hostapd-common=n
CONFIG_PACKAGE_kmod-mac80211=n

# 跑分（对应主线那套 coremark）
CONFIG_PACKAGE_coremark=y
CONFIG_COREMARK_OPTIMIZE_O3=y
CONFIG_COREMARK_ENABLE_MULTITHREADING=y
CONFIG_COREMARK_NUMBER_OF_THREADS=4

# 基础工具：看 NSS/PPE 状态、排查用
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_tcpdump-mini=y
CONFIG_PACKAGE_jq=y
CONFIG_PACKAGE_htop=y

# ---------------- 和主线 6.12 对齐的插件 ----------------
# UPnP（miniupnpd 的 nftables 版）
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_miniupnpd-nftables=y

# 按设备统计流量（netlink 记账，NSS 卸载后也能统计）
CONFIG_PACKAGE_luci-app-nlbwmon=y

# 内网测速：iperf3 命令行（页面用 luci-app-netspeedtest，由 workflow 单独 clone）
CONFIG_PACKAGE_iperf3=y

# 测速插件本体（依赖 ookla-speedtest / homebox / python3，由 workflow clone）
CONFIG_PACKAGE_luci-app-netspeedtest=y

# USB / 外接存储
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-nls-utf8=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_usbutils=y

# LED 触发器（6.12 那边用的是 network/usbport）
CONFIG_PACKAGE_kmod-ledtrig-network=y
CONFIG_PACKAGE_kmod-usb-ledtrig-usbport=y

# eMMC 寿命检测：overlay 里的 emmc-health 需要 /sbin/mmc
CONFIG_PACKAGE_mmc-utils=y
# eMMC 健康页面（自建 LuCI 包，源码在仓库 packages/luci-app-emmc-health）
CONFIG_PACKAGE_luci-app-emmc-health=y

# ---------------- Docker（NN6000 是 eMMC，放得下）----------------
CONFIG_PACKAGE_luci-app-dockerman=y
CONFIG_PACKAGE_luci-lib-docker=y
CONFIG_PACKAGE_docker=y
CONFIG_PACKAGE_dockerd=y
CONFIG_PACKAGE_containerd=y
CONFIG_PACKAGE_runc=y
CONFIG_PACKAGE_tini=y
CONFIG_PACKAGE_cgroupfs-mount=y

# ---------------- 第三方插件（对应主线的 THIRD-PARTY 段）----------------
# 由 workflow 调用 scripts/prepare-feeds.sh 拉取；某个包如果这棵树上没有，
# kconfig 会静默丢掉它，不影响其它包。
# iStore
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_luci-lib-taskd=y
CONFIG_PACKAGE_luci-lib-xterm=y
CONFIG_PACKAGE_taskd=y
# 磁盘 / 分区
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_luci-app-partexp=y
# 定时重启
CONFIG_PACKAGE_luci-app-autoreboot=y
# 主题
CONFIG_PACKAGE_luci-theme-aurora=y
CONFIG_PACKAGE_luci-app-aurora-config=y
# 远程 / 推送
CONFIG_PACKAGE_ddnsto=y
CONFIG_PACKAGE_luci-app-ddnsto=y
CONFIG_PACKAGE_luci-app-wechatpush=y
# 集客 AC
CONFIG_PACKAGE_gecoosac=y
CONFIG_PACKAGE_luci-app-gecoosac=y

# 界面
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y

# 中文语言包
# 关键：必须先开 LUCI_LANG_zh_Hans，luci.mk 生成的 luci-i18n-*-zh-cn 才有 DEFAULT=y，
# 否则它们是 HIDDEN 的可选包，只写包名会被 kconfig 静默丢掉（实测踩过）。
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y
CONFIG_PACKAGE_luci-i18n-opkg-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y
CONFIG_PACKAGE_luci-i18n-nlbwmon-zh-cn=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_luci-i18n-dockerman-zh-cn=y
CONFIG_PACKAGE_luci-i18n-diskman-zh-cn=y
CONFIG_PACKAGE_luci-i18n-netspeedtest-zh-cn=y
CONFIG_PACKAGE_luci-i18n-cpufreq-zh-cn=y

# 终端（页面上直接开 shell）
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_luci-app-ttyd=y

# CPU 性能调节（调频/调 governor）
CONFIG_PACKAGE_luci-app-cpufreq=y

# Vantage 主题（卡片式仪表盘：网络路径 / 吞吐量 / 射频 / 客户端）
# 源码由 workflow 从 anothaDev/luci-theme-vantage clone 到 package/
CONFIG_PACKAGE_luci-theme-vantage=y
CONFIG_PACKAGE_luci-app-vantage=y
