# =====================================================================
#  公共配置：目标平台 + 三个机型 + 满血 NSS + 通用组件
#  ——这里不放无线相关的东西，无线差异在 wifi.config / nowifi.config 里
# =====================================================================

# ------------------------- 目标平台 -------------------------
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_MULTI_PROFILE=y

# ------------------------- 机型 -----------------------------
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_redmi_ax5=y
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_zn_m2=y
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_link_nn6000-v2=y

# --------------------- NSS 硬件加速（核心）------------------
# ipq60xx 用的是 NSS 11.4 固件；选错版本加速会不工作
CONFIG_NSS_FIRMWARE_VERSION_11_4=y

# 目标默认包里已带全套 NSS 组件，这里显式写一遍，防止上游改了默认包
CONFIG_PACKAGE_kmod-qca-nss-drv=y
CONFIG_PACKAGE_kmod-qca-nss-dp=y
CONFIG_PACKAGE_kmod-qca-nss-ecm=y
CONFIG_PACKAGE_kmod-nss-ifb=y
CONFIG_PACKAGE_kmod-qca-nss-drv-pppoe=y
CONFIG_PACKAGE_kmod-qca-nss-drv-qdisc=y

# NSS 客户端模块（IGS 整形、VLAN/bridge 管理、隧道类卸载）
CONFIG_PACKAGE_kmod-qca-nss-drv-igs=y
CONFIG_PACKAGE_kmod-qca-nss-drv-bridge-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-vlan-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-tun6rd=y
CONFIG_PACKAGE_kmod-qca-nss-drv-tunipip6=y
CONFIG_PACKAGE_kmod-qca-nss-drv-l2tpv2=y

# ------------------------- 界面 / 语言 ----------------------
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-opkg=y
CONFIG_PACKAGE_luci-app-cpufreq=y
CONFIG_PACKAGE_luci-app-ttyd=y
# 兼容老的 Lua/CBI 插件（iStore、微信推送、DDNSTO 的页面要用）
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-lua-runtime=y

# --------------------- miniupnpd（UPnP IGD）-----------------
# miniupnpd 是虚拟包名，实际由 -nftables / -iptables 变体提供；
# 25.12 用 firewall4(nftables)，所以选 nftables 变体
CONFIG_PACKAGE_miniupnpd-nftables=y
CONFIG_PACKAGE_luci-app-upnp=y

# ------------------------- 常用工具 -------------------------
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y

# ---------------------- USB / 外接存储 -----------------------
# 目标默认包只带 kmod-usb3 + dwc3 + qcom 主控，插 U 盘是认不出来的，这里补全
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y

# 文件系统（U 盘 / 移动硬盘常见格式）
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-msdos=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-fs-btrfs=y
CONFIG_PACKAGE_kmod-nls-cp437=y
CONFIG_PACKAGE_kmod-nls-iso8859-1=y
CONFIG_PACKAGE_kmod-nls-utf8=y

# 挂载与磁盘工具
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_dosfstools=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_btrfs-progs=y
CONFIG_PACKAGE_smartmontools=y
CONFIG_PACKAGE_usbutils=y

# USB 串口（CH340 / CP210x / FTDI / PL2303，接路由器调试口/传感器）
CONFIG_PACKAGE_kmod-usb-serial=y
CONFIG_PACKAGE_kmod-usb-serial-ch341=y
CONFIG_PACKAGE_kmod-usb-serial-cp210x=y
CONFIG_PACKAGE_kmod-usb-serial-ftdi=y
CONFIG_PACKAGE_kmod-usb-serial-pl2303=y

# USB 网卡（手机共享网络 / USB 2.5G 网卡）
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-net-asix=y
CONFIG_PACKAGE_kmod-usb-net-asix-ax88179=y

# USB 键盘鼠标 / 打印机
CONFIG_PACKAGE_kmod-usb-hid=y
CONFIG_PACKAGE_kmod-usb-printer=y

# --------------------------- LED -----------------------------
# LuCI 的「系统 → LED 配置」页面本身由 luci-mod-system 提供，
# 但没有下面的 trigger 模块时，页面上只能改名字，加不了「网络活动/定时/心跳」这些模式
CONFIG_PACKAGE_kmod-ledtrig-netdev=y
CONFIG_PACKAGE_kmod-ledtrig-timer=y
CONFIG_PACKAGE_kmod-ledtrig-heartbeat=y
CONFIG_PACKAGE_kmod-ledtrig-default-on=y
CONFIG_PACKAGE_kmod-ledtrig-transient=y
# USB 口读写指示灯（插 U 盘就闪的那个）
CONFIG_PACKAGE_kmod-usb-ledtrig-usbport=y

# ---------------------- 家用常用插件 ------------------------
# 按设备统计流量（netlink 记账，流量走 NSS 卸载也能统计到）
CONFIG_PACKAGE_luci-app-nlbwmon=y

# ------------------------- 其它 -----------------------------
CONFIG_TARGET_ROOTFS_SQUASHFS=y

# >>> THIRD-PARTY-BEGIN
# =====================================================================
#  第三方插件（feed 见 config/feeds.extra.conf）
#  enable_thirdparty=no 时整段会被 scripts/prepare-config.sh 删掉
# =====================================================================

# ---- iStore 应用商店 ----
# 来源：官方 istore feed（istoreos/istore 的 luci/ 子目录），
# 拉不到时 scripts/prepare-feeds.sh 会自动回退到 kenzo feed（两个 feed 里是同一份内容）
CONFIG_PACKAGE_luci-app-store=y
# 下面三个是 iStore 的运行时依赖，缺任何一个的表现是：页面能开但点安装没反应 / 白屏
CONFIG_PACKAGE_luci-lib-taskd=y
CONFIG_PACKAGE_taskd=y
CONFIG_PACKAGE_luci-lib-xterm=y

# ---- DiskMan 磁盘管理（lisaac/luci-app-diskman）----
# 分区/格式化/挂载/SMART/RAID 一把梭，配合上面的 USB + 文件系统模块使用
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_luci-app-diskman_INCLUDE_ntfs_3g_utils=y
CONFIG_PACKAGE_luci-app-diskman_INCLUDE_btrfs_progs=y
CONFIG_PACKAGE_luci-app-diskman_INCLUDE_lsblk=y
CONFIG_PACKAGE_luci-app-diskman_INCLUDE_mdadm=y
CONFIG_PACKAGE_luci-app-diskman_INCLUDE_kmod_md_raid456=y
CONFIG_PACKAGE_luci-app-diskman_INCLUDE_kmod_md_linears=y

# ---- 分区扩容（kenzok8 的 luci-app-partexp）----
# eMMC 机型（NN6000 v2）尤其有用：把没用到的空间并进 overlay，省得手动 parted
CONFIG_PACKAGE_luci-app-partexp=y

# ---- HomeProxy（immortalwrt 的 luci-app-homeproxy + sing-box）----
# 由 scripts/prepare-feeds.sh 用 sparse checkout 拉下来放到 package/iluci/applications/
CONFIG_PACKAGE_luci-app-homeproxy=y
CONFIG_PACKAGE_sing-box=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_ucode-mod-digest=y
# sing-box 的 NaiveProxy 出站要 libcronet（本树没有这个包），关掉它其余协议不受影响
# CONFIG_SING_BOX_BUILD_NAIVE_OUTBOUND is not set

# ---- 定时重启（immortalwrt 的 luci-app-autoreboot）----
CONFIG_PACKAGE_luci-app-autoreboot=y

# ---- DDNSTO 内网穿透远程控制 ----
CONFIG_PACKAGE_ddnsto=y
CONFIG_PACKAGE_luci-app-ddnsto=y

# ---- 微信推送（tty228 v3.6.x）----
CONFIG_PACKAGE_luci-app-wechatpush=y

# ---- Aurora 主题（ChenLing93/luci-theme-aurora）----
# 由 scripts/prepare-feeds.sh 直接 clone 到 package/luci-theme-aurora
# 主题自带 /etc/uci-defaults/30_luci-theme-aurora，装上即自动设为默认主题
CONFIG_PACKAGE_luci-theme-aurora=y

# ---- Aurora 设置插件（eamonxg/luci-app-aurora-config）----
# 预设、配色、导航布局、悬浮工具栏、主题商店；同样 clone 到 package/
CONFIG_PACKAGE_luci-app-aurora-config=y

# ---- 集客软 AC 控制器（aarch64 二进制约 16MB）----
CONFIG_PACKAGE_gecoosac=y
CONFIG_PACKAGE_luci-app-gecoosac=y

# <<< THIRD-PARTY-END

# =====================================================================
#  Docker（只有 enable_docker=yes 才会保留，否则整块被 prepare-config.sh 删掉）
#
#  体积警告：dockerd + containerd + runc + docker CLI 装完约 60MB，
#  AX5 / ZN-M2 是 128MB flash，和 sing-box / 集客 AC 一起全开必炸；
#  NN6000 v2（eMMC）或你确认够大再打开。
# =====================================================================
# >>> DOCKER-BEGIN
CONFIG_PACKAGE_luci-app-dockerman=y
CONFIG_PACKAGE_luci-lib-docker=y
CONFIG_PACKAGE_docker=y
CONFIG_PACKAGE_dockerd=y
CONFIG_PACKAGE_containerd=y
CONFIG_PACKAGE_runc=y
CONFIG_PACKAGE_tini=y
CONFIG_PACKAGE_cgroupfs-mount=y
# <<< DOCKER-END
