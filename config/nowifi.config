# =====================================================================
#  变体：NOWIFI —— 不带无线，开机也不会起无线
#
#  做法与 LibWrt 自己给「京东云 RE-CS-07（无 WiFi 机型）」的定义一致：
#    DEVICE_PACKAGES := -ath11k-firmware-ipq6018 -kmod-ath11k -kmod-ath11k-ahb
#                       -kmod-ath11k-pci -hostapd-common -wpad-openssl
#  我们这三个机型的 DEVICE_PACKAGES 只有 ipq-wifi-*（板级校准数据，
#  不依赖驱动），所以在 .config 里把驱动/hostapd 关掉即可，
#  镜像里没有 ath11k 内核模块、没有 wpad，物理上没有东西能起无线。
#
#  注意：kconfig 里“关闭”必须写成下面这种注释形式，不能写 =n。
# =====================================================================

# ---- 关掉无线驱动 ath11k（AHB + PCI 两个口都关）----
# CONFIG_PACKAGE_kmod-ath11k is not set
# CONFIG_PACKAGE_kmod-ath11k-ahb is not set
# CONFIG_PACKAGE_kmod-ath11k-pci is not set

# ---- 关掉 hostapd / wpad（各家变体都写一遍，存在哪个关哪个）----
# CONFIG_PACKAGE_wpad-openssl is not set
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set
# CONFIG_PACKAGE_wpad-mbedtls is not set
# CONFIG_PACKAGE_wpad-wolfssl is not set
# CONFIG_PACKAGE_wpad-basic-wolfssl is not set
# CONFIG_PACKAGE_hostapd-common is not set

# ---- 无 ath11k 时这些选项没有意义 ----
# CONFIG_ATH11K_NSS_MESH_SUPPORT is not set
# CONFIG_ATH11K_MEM_PROFILE_512M is not set

# ---- 顺带省掉无线相关的小件（有就关，没有就忽略）----
# CONFIG_PACKAGE_luci-app-wifischedule is not set
# CONFIG_PACKAGE_kmod-qca-nss-drv-wifi-meshmgr is not set
